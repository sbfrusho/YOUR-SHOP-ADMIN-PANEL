{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "nabilrayhanshopping",
          "appId": "1:1076136965050:android:9fc1dec8fc2acae9896383",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "nabilrayhanshopping",
          "configurations": {
            "android": "1:1076136965050:android:9fc1dec8fc2acae9896383",
            "ios": "1:1076136965050:ios:1604bba7009e555c896383",
            "macos": "1:1076136965050:ios:1604bba7009e555c896383",
            "web": "1:1076136965050:web:a0121967982bdbd2896383",
            "windows": "1:1076136965050:web:40a41fb3b8d6f47b896383"
          }
        }
      }
    }
  },
  "hosting": [
    {
      "target": "admin",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "predeploy": [
        "flutter build web --release --dart-define-from-file=env/prod.json"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|json|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|svg|ico|ttf|otf|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    }
  ]
}
